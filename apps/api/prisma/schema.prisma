// Outpost data model. PostgreSQL / Supabase.
// Tenant isolation is enforced in the API layer and by carrying teamId through
// every tenant-owned aggregate. UUIDs are generated by PostgreSQL-compatible
// application defaults where possible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  TEST
}

enum IntegrationType {
  SUPABASE
  POSTGRESQL
  MYSQL
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  PAUSED
}

enum MonitorMethod {
  GET
  HEAD
}

enum MonitorHealth {
  UNKNOWN
  UP
  DOWN
}

enum EgressMode {
  DEFAULT
  PROXY
  REGION
}

enum RunStatus {
  SUCCESS
  FAILURE
  TIMEOUT
  CONNECTION_ERROR
}

enum JobType {
  HEALTH_CHECK
  HEARTBEAT
  DATABASE_METRICS
  REPORT_GENERATION
  RETENTION_CLEANUP
  NOTIFICATION_RETRY
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ErrorSeverity {
  FATAL
  ERROR
  WARNING
  INFO
}

enum ErrorStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

enum IncidentType {
  DOWNTIME
  HIGH_LATENCY
  DATABASE
  HEARTBEAT_FAILURE
  ERROR_SPIKE
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertEventType {
  DOWNTIME
  RECOVERY
  HIGH_LATENCY
  DATABASE_CONNECTION_FAILURE
  HEARTBEAT_FAILURE
  NEW_ERROR
  INCIDENT_CREATED
}

enum NotificationChannelType {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum HeartbeatStatus {
  SUCCESS
  FAILURE
}

model UserProfile {
  id             String   @id @default(uuid()) @db.Uuid
  supabaseUserId String   @unique
  email          String   @unique
  fullName       String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedTeams         Team[]           @relation("TeamOwner")
  memberships        TeamMember[]
  invitationsCreated TeamInvitation[] @relation("InvitationCreator")
  reportsCreated     Report[]         @relation("ReportCreator")
  sharesCreated      ReportShare[]    @relation("ShareCreator")
  auditLogs          AuditLog[]       @relation("AuditActor")

  @@index([email])
}

model Team {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  ownerId       String   @db.Uuid
  retentionDays Int      @default(90)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner                  UserProfile            @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                TeamMember[]
  invitations            TeamInvitation[]
  projects               Project[]
  notificationChannels   NotificationChannel[]
  auditLogs              AuditLog[]
  notificationDeliveries NotificationDelivery[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      TeamRole @default(VIEWER)
  createdAt DateTime @default(now())

  team Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
}

model TeamInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  teamId      String           @db.Uuid
  email       String
  role        TeamRole         @default(VIEWER)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?          @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy UserProfile? @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([teamId, email, status])
  @@index([email])
}

model Project {
  id                 String      @id @default(uuid()) @db.Uuid
  teamId             String      @db.Uuid
  name               String
  description        String?
  environment        Environment @default(PRODUCTION)
  ingestionKeyHash   String      @unique
  ingestionKeyPrefix String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  services        Service[]
  integrations    Integration[]
  monitors        Monitor[]
  errorGroups     ErrorGroup[]
  errorEvents     ErrorEvent[]
  incidents       Incident[]
  alertRules      AlertRule[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  auditLogs       AuditLog[]

  @@index([teamId, createdAt])
  @@index([teamId, name])
}

model Service {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @db.Uuid
  name        String
  description String?
  environment Environment @default(PRODUCTION)
  runtime     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitors Monitor[]
  errors   ErrorEvent[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Integration {
  id                           String            @id @default(uuid()) @db.Uuid
  projectId                    String            @db.Uuid
  type                         IntegrationType   @default(SUPABASE)
  name                         String
  status                       IntegrationStatus @default(PENDING)
  configEncrypted              String
  credentialHint               String?
  heartbeatEnabled             Boolean           @default(true)
  heartbeatIntervalMinutes     Int               @default(15)
  heartbeatNextRunAt           DateTime?
  heartbeatLastSuccessAt       DateTime?
  heartbeatLastAttemptAt       DateTime?
  heartbeatConsecutiveFailures Int               @default(0)
  metricsEnabled               Boolean           @default(false)
  metricsIntervalMinutes       Int               @default(15)
  metricsNextRunAt             DateTime?
  metricsConsecutiveFailures   Int               @default(0)
  lastError                    String?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  heartbeatRuns   HeartbeatRun[]
  databaseMetrics DatabaseMetric[]
  jobs            MonitoringJob[]
  incidents       Incident[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([heartbeatEnabled, heartbeatNextRunAt])
  @@index([metricsEnabled, metricsNextRunAt])
}

model Monitor {
  id                  String        @id @default(uuid()) @db.Uuid
  projectId           String        @db.Uuid
  serviceId           String?       @db.Uuid
  name                String
  url                 String
  method              MonitorMethod @default(GET)
  expectedStatusCodes Int[]         @default([200])
  timeoutMs           Int           @default(10000)
  intervalSeconds     Int           @default(300)
  active              Boolean       @default(true)
  egressMode          EgressMode    @default(DEFAULT)
  region              String?
  failureThreshold    Int           @default(3)
  consecutiveFailures Int           @default(0)
  lastStatus          MonitorHealth @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastLatencyMs       Int?
  nextRunAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  runs      MonitorRun[]
  incidents Incident[]
  jobs      MonitoringJob[]

  @@index([projectId, active, nextRunAt])
  @@index([serviceId])
  @@index([lastStatus])
}

model MonitorRun {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @db.Uuid
  jobId      String?   @unique @db.Uuid
  status     RunStatus
  statusCode Int?
  latencyMs  Int?
  egress     String?
  error      String?
  checkedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@index([status, checkedAt])
}

model MonitoringJob {
  id               String    @id @default(uuid()) @db.Uuid
  type             JobType
  status           JobStatus @default(QUEUED)
  dedupeKey        String    @unique
  monitorId        String?   @db.Uuid
  integrationId    String?   @db.Uuid
  reportId         String?   @db.Uuid
  reportScheduleId String?   @db.Uuid
  region           String?
  scheduledFor     DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  startedAt        DateTime?
  completedAt      DateTime?
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  lastError        String?
  result           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  monitor        Monitor?        @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  integration    Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  report         Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportSchedule ReportSchedule? @relation(fields: [reportScheduleId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([status, region, scheduledFor])
  @@index([lockedAt])
  @@index([type, createdAt])
  @@index([monitorId])
  @@index([integrationId])
  @@index([reportScheduleId])
}

model DatabaseMetric {
  id                  String   @id @default(uuid()) @db.Uuid
  integrationId       String   @db.Uuid
  jobId               String?  @unique @db.Uuid
  connectivity        Boolean
  connectionLatencyMs Int?
  activeConnections   Int?
  maxConnections      Int?
  databaseSizeBytes   BigInt?
  longRunningQueries  Int?
  locks               Int?
  slowQueries         Json?
  transactionStats    Json?
  unavailableReasons  Json?
  error               String?
  collectedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, collectedAt])
  @@index([collectedAt])
}

model HeartbeatRun {
  id            String          @id @default(uuid()) @db.Uuid
  integrationId String          @db.Uuid
  jobId         String?         @unique @db.Uuid
  status        HeartbeatStatus
  latencyMs     Int?
  statusCode    Int?
  error         String?
  executedAt    DateTime        @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, executedAt])
  @@index([status, executedAt])
}

model ErrorGroup {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  fingerprint   String
  errorType     String
  message       String
  serviceName   String
  environment   Environment   @default(PRODUCTION)
  severity      ErrorSeverity @default(ERROR)
  status        ErrorStatus   @default(UNRESOLVED)
  eventCount    Int           @default(1)
  firstSeen     DateTime      @default(now())
  lastSeen      DateTime      @default(now())
  stackSample   String?
  lastAlertedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  ErrorEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId, lastSeen])
  @@index([projectId, status, severity])
}

model ErrorEvent {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @db.Uuid
  errorGroupId String      @db.Uuid
  serviceId    String?     @db.Uuid
  fingerprint  String
  errorType    String
  message      String
  stackTrace   String?
  serviceName  String
  environment  Environment @default(PRODUCTION)
  httpStatus   Int?
  path         String?
  metadata     Json?
  timestamp    DateTime    @default(now())
  createdAt    DateTime    @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  errorGroup ErrorGroup @relation(fields: [errorGroupId], references: [id], onDelete: Cascade)
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([errorGroupId, createdAt])
  @@index([projectId, timestamp])
}

model Incident {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  monitorId        String?          @db.Uuid
  integrationId    String?          @db.Uuid
  type             IncidentType
  status           IncidentStatus   @default(OPEN)
  severity         IncidentSeverity @default(MEDIUM)
  title            String
  summary          String
  dedupeKey        String?          @unique
  startedAt        DateTime         @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?          @db.Uuid
  resolvedAt       DateTime?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitor     Monitor?               @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  integration Integration?           @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  deliveries  NotificationDelivery[]

  @@index([projectId, status, startedAt])
  @@index([status, severity])
}

model AlertRule {
  id                 String         @id @default(uuid()) @db.Uuid
  projectId          String         @db.Uuid
  type               AlertEventType
  enabled            Boolean        @default(true)
  cooldownMinutes    Int            @default(30)
  failureThreshold   Int            @default(3)
  latencyThresholdMs Int?           @default(2000)
  recipients         String[]
  lastTriggeredAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([projectId, type])
  @@index([projectId])
}

model NotificationChannel {
  id        String                  @id @default(uuid()) @db.Uuid
  teamId    String                  @db.Uuid
  name      String
  type      NotificationChannelType @default(EMAIL)
  config    Json
  enabled   Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([teamId])
}

model NotificationDelivery {
  id            String             @id @default(uuid()) @db.Uuid
  teamId        String             @db.Uuid
  alertRuleId   String?            @db.Uuid
  incidentId    String?            @db.Uuid
  channelId     String?            @db.Uuid
  reportId      String?            @db.Uuid
  recipient     String
  subject       String
  bodyHtml      String?
  bodyText      String?
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  providerId    String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  team      Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  alertRule AlertRule?           @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  incident  Incident?            @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  channel   NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  report    Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([teamId, createdAt])
  @@index([alertRuleId])
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @db.Uuid
  createdById     String?      @db.Uuid
  jobId           String?      @unique @db.Uuid
  type            ReportType   @default(CUSTOM)
  status          ReportStatus @default(PENDING)
  name            String
  periodStart     DateTime
  periodEnd       DateTime
  snapshot        Json?
  content         Bytes?
  sizeBytes       Int?
  emailRecipients String[]
  error           String?
  generatedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  UserProfile?           @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  shares     ReportShare[]
  deliveries NotificationDelivery[]
  jobs       MonitoringJob[]

  @@index([projectId, createdAt])
  @@index([projectId, type, status])
}

model ReportSchedule {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @db.Uuid
  name       String
  frequency  ReportFrequency @default(WEEKLY)
  enabled    Boolean         @default(true)
  recipients String[]
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs    MonitoringJob[]

  @@index([projectId])
  @@index([enabled, nextRunAt])
}

model ReportShare {
  id           String    @id @default(uuid()) @db.Uuid
  reportId     String    @db.Uuid
  createdById  String?   @db.Uuid
  tokenHash    String    @unique
  tokenPrefix  String
  expiresAt    DateTime?
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy UserProfile? @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  projectId    String?  @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   UserProfile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId])
}
