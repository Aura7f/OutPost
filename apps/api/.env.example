# ---- Application ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Serve Swagger at /docs. Defaults to on outside production and off in production.
SWAGGER_ENABLED=true
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# Browser session cookie policy: lax (same-site), strict, or none (cross-site HTTPS only).
AUTH_COOKIE_SAMESITE=lax
LOG_LEVEL=info

# ---- Database (Supabase PostgreSQL) ----
# Use the pooled connection string for the API.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Direct connection for migrations. Never expose this to the browser.
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ----
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable/anon key. Required: the API exchanges credentials and sets HTTP-only
# session cookies on behalf of the browser. Never use the secret/service-role key.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Use one of the following. Legacy projects sign tokens with SUPABASE_JWT_SECRET.
# New projects should use asymmetric JWT signing keys and JWKS.
SUPABASE_JWT_SECRET=
# Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Encryption at rest ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by setting a new current key and retaining ENCRYPTION_KEY_OLD temporarily.
ENCRYPTION_KEY=
ENCRYPTION_KEY_OLD=

# ---- Scheduler ----
# Required header value for Supabase Cron -> /v1/internal/cron/dispatch
CRON_SECRET=
# Optional for local development: process durable jobs in-process every minute.
ALLOW_LOCAL_SCHEDULER=false
MONITORING_CONCURRENCY=5
JOB_LOCK_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3
# Default monitoring-history retention for newly created workspaces.
DEFAULT_RETENTION_DAYS=90

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Outpost <alerts@yourdomain.com>
EMAIL_REPLY_TO=

# ---- Monitoring ----
# Hostnames blocked in addition to RFC1918/link-local/loopback protections.
MONITOR_BLOCKED_HOSTS=
# Comma-separated ports allowed for HTTP checks. Keep 443 for HTTPS.
SSRF_ALLOWED_PORTS=80,443
# Development only. Both are ignored when NODE_ENV=production.
SSRF_ALLOW_PRIVATE_NETWORKS=false
ALLOW_INSECURE_DATABASE_URL=false
ALLOW_PRIVATE_DATABASE_HOSTS=false

# ---- Monitoring egress ----
# HTTP(S) proxy URLs for monitors set to egress mode PROXY, rotated per check.
# Credentials in the URL are supported; never expose this list to the browser.
MONITOR_PROXY_URLS=
# Comma-separated region ids served by checker workers (exposed to the web app).
CHECKER_REGIONS=
# API instances leave this empty. Checker workers set one region id from the list.
WORKER_REGION=
# How often a checker worker polls the durable job queue.
CHECKER_POLL_SECONDS=10

# ---- OpenTelemetry ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=outpost-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_DEBUG=false

# ---- Rate limits ----
INGEST_RATE_LIMIT_PER_MINUTE=120
